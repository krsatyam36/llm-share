#!/bin/bash

echo "Initializing LLM-Share Environment..."
echo ""

# 1. Fetch available models from ollama and store them in an array
mapfile -t models < <(ollama list | awk 'NR>1 {print $1}')

if [ ${#models[@]} -eq 0 ]; then
    echo "No Ollama models found! Please run 'ollama pull <model>' first."
    exit 1
fi

echo "Available models:"
# 2. Print models with serial numbers
for i in "${!models[@]}"; do
    printf "  [%2d] %s\n" "$((i+1))" "${models[$i]}"
done
echo ""

# Set default selection index to gemma3:4b if available, otherwise default to item 1
default_idx=1
for i in "${!models[@]}"; do
    if [[ "${models[$i]}" == "gemma3:4b" ]]; then
        default_idx=$((i+1))
        break
    fi
done

# 3. Prompt user for the serial number
read -p "Select multimodal LLM to use [Default Number: $default_idx]: " choice

# If user hits Enter, use the calculated default index
if [ -z "$choice" ]; then
    choice=$default_idx
fi

# 4. Validation check on user input
if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#models[@]}" ]; then
    echo "Invalid selection. Falling back to default."
    SELECTED_MODEL="${models[$((default_idx-1))]}"
else
    SELECTED_MODEL="${models[$((choice-1))]}"
fi

echo ""
echo "Booting stream and binding to model: $SELECTED_MODEL..."
echo ""

# 5. Export choice and run the python service
export LLM_MODEL="$SELECTED_MODEL"
source llm-share/bin/activate
python3 server.py