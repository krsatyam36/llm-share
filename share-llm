#!/bin/bash

echo "LLM-Share — screen capture + AI code analysis"
echo ""

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 1. Detect monitors
mapfile -t monitors < <(xrandr | grep " connected" | awk '{print $1}')
if [ ${#monitors[@]} -gt 0 ]; then
    echo "Monitors detected:"
    for i in "${!monitors[@]}"; do
        printf "  [%d] %s\n" "$i" "${monitors[$i]}"
    done
    read -p "Capture which monitor? [0]: " mon_choice
    if [ -z "$mon_choice" ]; then mon_choice=0; fi
    export MONITOR="$mon_choice"
    echo "  -> Capturing: ${monitors[$mon_choice]}"
    echo ""
fi

# 2. Fetch available models
mapfile -t models < <(ollama list | awk 'NR>1 {print $1}')
if [ ${#models[@]} -eq 0 ]; then
    echo "No Ollama models found! Run: ollama pull gemma3:4b"
    exit 1
fi

echo "Available models:"
for i in "${!models[@]}"; do
    printf "  [%2d] %s\n" "$((i+1))" "${models[$i]}"
done
echo ""

# Default to gemma3:4b if available
default_idx=1
for i in "${!models[@]}"; do
    if [[ "${models[$i]}" == "gemma3:4b" ]]; then
        default_idx=$((i+1))
        break
    fi
done

read -p "Select LLM [Default: $default_idx]: " choice
if [ -z "$choice" ]; then choice=$default_idx; fi

if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#models[@]}" ]; then
    SELECTED_MODEL="${models[$((default_idx-1))]}"
else
    SELECTED_MODEL="${models[$((choice-1))]}"
fi

echo ""
echo "Starting — model: $SELECTED_MODEL"
echo ""

export LLM_MODEL="$SELECTED_MODEL"
source "$SCRIPT_DIR/llm-share/bin/activate"
cd "$SCRIPT_DIR"
python3 server.py